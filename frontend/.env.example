VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your_app_id_here

# Local development.
# For docker-compose backend (the default): leave this commented — api.ts
# auto-detects localhost and uses DEFAULT_LOCAL_API_BASE (127.0.0.1:8002,
# the host port the web container publishes; container internal is :8080,
# host is :8002 to sidestep a local Apache that often squats on :8080).
# Set explicitly only if your backend is on a different host/port.
# VITE_API_BASE_URL=http://127.0.0.1:8002

# Production build: set in `.env.production` (gitignored), not here.
# Example: VITE_API_BASE_URL=https://your-service-url.run.app
